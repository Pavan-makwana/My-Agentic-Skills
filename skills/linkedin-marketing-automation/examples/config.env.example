# ==============================================================================
# LINKEDIN MARKETING AUTOMATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Buffer GraphQL API Middleware (Official Certified LinkedIn Partner)
BUFFER_API_KEY=your_buffer_api_key_here
BUFFER_CHANNEL_ID=your_buffer_linkedin_channel_id_here

# Direct LinkedIn Member OAuth (Optional fallback for personal profile posting)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
LINKEDIN_ACCESS_TOKEN=your_personal_access_token_here

# Discord Review Co-Pilot Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Automation Timers & Operational Modes
DRY_RUN=false
TIMEZONE=Asia/Kolkata
SCHEDULE_HOUR=20
SCHEDULE_MINUTE=30
